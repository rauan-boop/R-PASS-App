# Public Supabase URL for the shared R-CORE instance. No trailing slash.
SUPABASE_URL=https://supabase.example.com

# Supabase browser anon/publishable key. This is embedded in the web bundle;
# never use a service_role or secret key here.
SUPABASE_ANON_KEY=replace-with-r-core-anon-key

# Public Firebase web configuration. These values are embedded in the web bundle.
FIREBASE_API_KEY=replace-with-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=replace-with-sender-id
FIREBASE_APP_ID=replace-with-web-app-id

# Public service and asset endpoints. No trailing slash.
FLUTTERFLOW_ASSETS_BASE_URL=https://storage.googleapis.com/flutterflow-io-6f20.appspot.com/projects/black-list-uj2qwn/assets
TELEGRAM_SUPPORT_URL=https://t.me/your_support_account
WHATSAPP_BASE_URL=https://wa.me
IP_ADDRESS_API_URL=https://api.ipify.org?format=json

# Host port exposed by the Nginx container.
R_PASS_PORT=8080
