# true  = visual demo with built-in mock data (no Supabase needed, nothing is saved).
# false = real mode, SUPABASE_URL and SUPABASE_ANON_KEY below are required.
DEMO_MODE=true

# Public Supabase URL for the shared R-CORE instance. No trailing slash.
# Not needed while DEMO_MODE=true.
SUPABASE_URL=
# Supabase browser anon/publishable key. Embedded in the web bundle;
# never use a service_role or secret key here.
SUPABASE_ANON_KEY=

# Optional public endpoints. No trailing slash.
FLUTTERFLOW_ASSETS_BASE_URL=
TELEGRAM_SUPPORT_URL=https://t.me/your_support_account
WHATSAPP_BASE_URL=https://wa.me
IP_ADDRESS_API_URL=https://api.ipify.org?format=json

# Host port exposed by the Nginx container.
R_PASS_PORT=8080
